<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="rettangolo"/>
        <attribute name="authors" value="alex"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-28 04:11:55 PM"/>
        <attribute name="created" value="YWxleDtDQUxWSU47MjAyNi0wOS0yODswMjo0OTo1NyBQTTsyMTcx"/>
        <attribute name="edited" value="YWxleDtDQUxWSU47MjAyNi0wOS0yODswNDoxMTo1NSBQTTsxOzIyNjg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="base, altezza, perimetro, area" type="Integer" array="False" size=""/>
            <input variable="base"/>
            <input variable="altezza"/>
            <assign variable="perimetro" expression="2 * (base + altezza)"/>
            <assign variable="area" expression="base * altezza"/>
            <output expression="perimetro" newline="True"/>
            <output expression="area" newline="True"/>
        </body>
    </function>
</flowgorithm>
