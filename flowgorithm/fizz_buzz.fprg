    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N" type="Integer" array="False" size=""/>
            <input variable="N"/>
            <if expression="N % 3 == 0">
                <then>
                    <output expression="&quot;Fizz&quot;" newline="True"/>
                </then>
                <else/>
            </if>
            <if expression="N % 5 == 0">
                <then>
                    <output expression="&quot;Buzz&quot;" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
