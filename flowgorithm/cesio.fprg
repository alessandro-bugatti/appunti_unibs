<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="cesio"/>
        <attribute name="authors" value="alex"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-29 04:11:04 PM"/>
        <attribute name="created" value="YWxleDtDQUxWSU47MjAyNi0wOS0yOTswMzoyNjowMyBQTTsyMTU5"/>
        <attribute name="edited" value="YWxleDtDQUxWSU47MjAyNi0wOS0yOTswNDoxMTowNCBQTTsyOzIyNjQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cesio" type="Real" array="False" size=""/>
            <declare name="anni" type="Integer" array="False" size=""/>
            <assign variable="anni" expression="0"/>
            <input variable="cesio"/>
            <while expression="cesio &gt;= 0.001">
                <assign variable="cesio" expression="cesio / 2"/>
                <assign variable="anni" expression="anni + 30"/>
            </while>
            <output expression="anni" newline="True"/>
        </body>
    </function>
</flowgorithm>
