<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="maggiore"/>
        <attribute name="authors" value="alex"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-29 05:25:22 PM"/>
        <attribute name="created" value="YWxleDtDQUxWSU47MjAyNi0wOS0yOTswNToxNjoxMyBQTTsyMTYx"/>
        <attribute name="edited" value="YWxleDtDQUxWSU47MjAyNi0wOS0yOTswNToyNToyMiBQTTsxOzIyNjk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <if expression="a &gt; b">
                <then>
                    <if expression="a &gt; c">
                        <then>
                            <output expression="a" newline="True"/>
                        </then>
                        <else>
                            <output expression="c" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="b &gt; c">
                        <then>
                            <output expression="b" newline="True"/>
                        </then>
                        <else>
                            <output expression="c" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <comment text="Da qui in poi sono soluzioni alternative non complete"/>
            <if expression="a &gt;= c &amp;&amp; a &gt;= b">
                <then>
                    <output expression="a" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
